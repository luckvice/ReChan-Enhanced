{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReChan Launcher",
  "version": "0.1.0",
  "identifier": "com.luckvice.rechanlauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RE:Chan Launcher",
        "width": 1280,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Launcher for the ReChan reimplementation",
    "longDescription": "Desktop launcher for RE:Chan, an unofficial reimplementation of Jackie Chan Stuntmaster. Requires your own legally obtained NTSC-U disc image.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
